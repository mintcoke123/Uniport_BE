# Copy this file to .env for local development.
# Do not commit .env because it contains secrets.

SPRING_PROFILES_ACTIVE=local

# Naver News Search API
# https://developers.naver.com/docs/serviceapi/search/news/news.md
NAVER_NEWS_ENABLED=true
NAVER_NEWS_CLIENT_ID=
NAVER_NEWS_CLIENT_SECRET=
NAVER_NEWS_CACHE_TTL_SECONDS=300
NAVER_NEWS_DISPLAY_PER_QUERY=10

# Public web issue collection. Run ./gradlew installPlaywrightChromium once before enabling.
# Disable with false only when the deployment cannot run Playwright Chromium.
UNIPORT_PUBLIC_WEB_ISSUES_ENABLED=true
UNIPORT_PUBLIC_WEB_ISSUES_TIMEOUT_MS=6000
UNIPORT_INVESTMENT_ISSUE_REFRESH_ENABLED=true
UNIPORT_INVESTMENT_ISSUE_REFRESH_DELAY_MS=300000
UNIPORT_INVESTMENT_ISSUE_REFRESH_INITIAL_DELAY_MS=30000
